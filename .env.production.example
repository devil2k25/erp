# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_KEY=                        # auto-generated by deploy.sh
APP_DEBUG=false
APP_URL=http://YOUR_SERVER_IP   # or https://yourdomain.com after SSL setup

# ─── MySQL ────────────────────────────────────────────────────────────────────
# Root password — required so TenantService can CREATE DATABASE per organization
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASS
MYSQL_MASTER_PASSWORD=CHANGE_ME_MASTER_PASS

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS

# ─── Frontend build-time vars (baked into Vue bundle) ─────────────────────────
VITE_API_URL=http://YOUR_SERVER_IP
VITE_SOCKET_URL=http://YOUR_SERVER_IP
